// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  semesters         Semester[]
  grades            Grade[]
  attendance        AttendanceRecord[]
  calendarEvents    CalendarEvent[]
  studyMaterials    StudyMaterial[]
  chatMessages      ChatMessage[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

model Semester {
  id        String   @id @default(cuid())
  name      String // e.g., "Fall 2024", "Spring 2025"
  startDate DateTime
  endDate   DateTime
  weeks     Int      @default(15) // Teaching weeks, used for attendance-hours math (not derived from dates)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses          Course[]
  timetableEntries TimetableEntry[]
  grades           Grade[]
  calendarEvents   CalendarEvent[]
  chatMessages     ChatMessage[]

  @@map("semesters")
}

model Course {
  id          String   @id @default(cuid())
  name        String
  code        String?
  creditHours Float    @default(3)
  semester    Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  semesterId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  timetableEntries TimetableEntry[]
  attendance       AttendanceRecord[]
  grade            Grade?
  studyMaterials   StudyMaterial[]
  chatMessages     ChatMessage[]

  @@map("courses")
}

model TimetableEntry {
  id         String   @id @default(cuid())
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  semesterId String

  dayOfWeek  Int // 0-6 (Sunday-Saturday)
  startTime  String // HH:MM format
  endTime    String // HH:MM format
  room       String?
  instructor String?

  attendanceRecords AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("timetable_entries")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  CANCELLED
}

model AttendanceRecord {
  id               String          @id @default(cuid())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  course           Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId         String
  // Which specific class session this record is for - needed when a course
  // meets more than once on the same day, so the two sessions don't collide
  // on (courseId, date) and overwrite each other. Nullable: SetNull (not
  // Cascade) so deleting/merging a timetable entry never destroys attendance
  // history, and older records predate this column.
  timetableEntry   TimetableEntry? @relation(fields: [timetableEntryId], references: [id], onDelete: SetNull)
  timetableEntryId String?

  date          DateTime // Date of the class
  status        AttendanceStatus @default(PRESENT)
  hoursDuration Float            @default(1)
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attendance_records")
}

model Grade {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  course     Course   @relation(fields: [courseId], references: [id])
  courseId   String   @unique
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  semesterId String

  // Source marks - ICA/TEE max vary per course (e.g. a capstone with no
  // TEE component), so they're stored per row rather than assumed 50/50.
  icaMarks Float?
  icaMax   Float  @default(50)
  teeMarks Float?
  teeMax   Float  @default(50)

  // Derived from the marks above via lib/gradeScale.ts at write time -
  // kept as columns (not recomputed on every read) so CGPA math and
  // display never have to re-run the percentage-to-grade lookup.
  letterGrade String?
  grade       Float // grade point, 0-4.0 scale
  percentage  Float? // final percentage (icaMarks+teeMarks)/(icaMax+teeMax)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("grades")
}

model CalendarEvent {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  semesterId String

  title       String
  description String?
  eventType   String // "exam", "assignment", "deadline", "holiday"
  dueDate     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("calendar_events")
}

model TimetableUpload {
  id            String   @id @default(cuid())
  semesterId    String
  uploadUrl     String
  fileType      String // "pdf", "jpg", "png"
  extractedText String? // OCR result
  status        String   @default("pending") // pending, processing, completed, failed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("timetable_uploads")
}

// A student's uploaded study material (a PDF or photo of notes) for one
// course. Only the extracted text is kept, not the original file bytes -
// same tradeoff the timetable-scan upload already makes - so this needs no
// separate file storage service to set up.
model StudyMaterial {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String

  fileName      String
  fileType      String // "pdf" | "image"
  extractedText String?
  status        String  @default("processing") // processing, completed, failed
  errorMessage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("study_materials")
}

// One row per turn in a study chat. There's exactly one ongoing thread per
// (userId, semesterId, courseId) triple - courseId null means the
// "ask across every subject this semester" scope - rather than a separate
// ChatThread model, since a student never needs more than one thread per
// scope.
model ChatMessage {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  semesterId String
  course     Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId   String? // null = cross-subject thread for this semester

  role          String // "user" | "assistant"
  content       String
  usedWebSearch Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("chat_messages")
}
