# Database
DATABASE_URL="postgresql://user:password@localhost:5432/timetable"
DIRECT_URL="postgresql://user:password@localhost:5432/timetable"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini (free tier) - used to auto-extract your timetable from an uploaded PDF/image
GEMINI_API_KEY=""

# File Storage (Optional - for future cloud storage)
VERCEL_BLOB_API_TOKEN=""

# Class-end attendance notifications (Web Push)
# Generate a pair once with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="" # same value as VAPID_PUBLIC_KEY, exposed to the browser

# Upstash QStash - schedules each day's class-end notifications to fire at
# the exact minute, since Vercel Hobby cron only runs once a day
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Public URL QStash calls back into (must be the real deployed URL, not localhost)
APP_URL="https://your-app.vercel.app"

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" so
# random requests can't trigger the daily scheduling job
CRON_SECRET=""
